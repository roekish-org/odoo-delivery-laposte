<odoo>
    <record id="view_delivery_carrier_form_laposte" model="ir.ui.view">
        <field name="name">delivery.carrier.form.laposte</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    name="laposte"
                    string="La Poste"
                    invisible="delivery_type != 'laposte'"
                >
                    <group>
                        <group string="Web service credentials">
                            <field name="laposte_account" />
                            <field
                                name="laposte_password"
                                password="True"
                            />
                            <button
                                name="action_laposte_test_connection"
                                type="object"
                                string="Test connection"
                                icon="fa-plug"
                                class="btn-link"
                            />
                        </group>
                        <group string="Shipment">
                            <field name="laposte_product_code" />
                            <field name="laposte_label_format" />
                        </group>
                    </group>
                    <group string="Pricing">
                        <field name="laposte_pricing_method" />
                    </group>
                    <field
                        name="laposte_tariff_ids"
                        invisible="laposte_pricing_method != 'grid'"
                    >
                        <list editable="bottom">
                            <field name="zone" />
                            <field name="max_weight" />
                            <field name="price" />
                            <field name="currency_id" column_invisible="1" />
                        </list>
                    </field>
                    <field
                        name="price_rule_ids"
                        nolabel="1"
                        invisible="laposte_pricing_method != 'base_on_rule'"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
