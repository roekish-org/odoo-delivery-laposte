<odoo>
    <data noupdate="1">
        <record id="module_category_delivery_laposte" model="ir.module.category">
            <field name="name">La Poste Delivery</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_delivery_laposte" model="res.groups.privilege">
            <field name="name">La Poste Delivery</field>
            <field name="category_id" ref="module_category_delivery_laposte" />
        </record>

        <record id="group_laposte_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_delivery_laposte" />
            <field
                name="implied_ids"
                eval="[(4, ref('stock.group_stock_user'))]"
            />
            <field
                name="comment"
            >Generate La Poste labels, track parcels and pick relay points.</field>
        </record>

        <record id="group_laposte_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_delivery_laposte" />
            <field
                name="implied_ids"
                eval="[(4, ref('group_laposte_user')), (4, ref('stock.group_stock_manager'))]"
            />
            <field
                name="comment"
            >Configure La Poste carriers, credentials and tariff grids.</field>
        </record>

        <!-- Multi-company isolation on tariff lines (via their carrier). -->
        <record id="laposte_tariff_company_rule" model="ir.rule">
            <field name="name">La Poste tariff: multi-company</field>
            <field name="model_id" ref="model_delivery_laposte_tariff" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >['|', ('carrier_id.company_id', '=', False), ('carrier_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
    <!-- The administrator is seeded into the La Poste Administrator group by
         the module's post_init_hook (res.users groups are role-managed in
         Odoo 19 and not reliably set from a data record). -->
</odoo>
